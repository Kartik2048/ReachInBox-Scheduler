# ==============================================================================
# REACHINBOX EMAIL JOB SCHEDULER - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database (Prisma connection string)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public"

# Redis Connection (Supports local redis:// or Upstash rediss://)
REDIS_URL="redis://localhost:6379"

# Security & Authentication
JWT_SECRET="reachinbox_super_secret_jwt_key_change_in_production"
JWT_EXPIRES_IN="7d"

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Worker & Queue Concurrency Settings
WORKER_CONCURRENCY=5

# Distributed Rate Limiting & Inter-Email Delay Spacing
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# Free-Tier Cloud Optimization Flags
# When set to true, boots the BullMQ worker within the Express API process (ideal for Render/Koyeb free tier)
RUN_WORKER_IN_API=true

# Smart Ethereal SMTP Transport & PaaS Port 587 Fallback
# When true, catches ETIMEDOUT / ECONNREFUSED on restricted hosting and generates deterministic preview URIs
SMTP_FALLBACK_ON_PORT_BLOCK=true

# Reviewer Fallback Authentication
# Allows 1-click test login for evaluators without configuring Google Cloud Console
ALLOW_DEMO_AUTH=true

# Optional: Dedicated Ethereal Account Credentials (if omitted, generated dynamically via nodemailer.createTestAccount())
ETHEREAL_USER=""
ETHEREAL_PASS=""

